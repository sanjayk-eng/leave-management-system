# ─── Frontend Environment Variables ─────────────────────────────────────────
# Copy this file to .env and fill in the values for your environment.

# Base URL of the backend API (no trailing slash)
# Development default: http://localhost:8082/api
VITE_API_BASE_URL=http://localhost:8082/api

# ─── Google OAuth ─────────────────────────────────────────────────────────────
# Get this from: https://console.cloud.google.com → APIs & Services → Credentials
# Create OAuth 2.0 Client ID → Web application
# Add Authorized JavaScript origins: http://localhost:8089
# Add Authorized redirect URIs: http://localhost:8089
VITE_GOOGLE_CLIENT_ID=your-google-client-id-here.apps.googleusercontent.com
