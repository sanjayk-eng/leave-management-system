# ─── Backend Environment Variables ───────────────────────────────────────────
# Copy this file to .env (in the repo root) and fill in the values.
# The backend reads the .env from ../../.env relative to cmd/server/main.go,
# which resolves to the repository root.

# ── Database ──────────────────────────────────────────────────────────────────
# PostgreSQL connection string
DB_URL=postgres://user:password@localhost:5432/leave_management?sslmode=disable

# ── Server ────────────────────────────────────────────────────────────────────
APP_PORT=8082

# ── Auth ──────────────────────────────────────────────────────────────────────
# Secret key used to sign JWT tokens — use a long, random string in production
SECRET_KEY=your-secret-key-here

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Frontend server URL (used internally for redirects / links)
F_SERVER=http://localhost:5173

# ── Email (Resend) ────────────────────────────────────────────────────────────
# API key from https://resend.com
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

# Verified sender address configured in your Resend account
RESEND_FROM=noreply@yourdomain.com

# ── Notifications ─────────────────────────────────────────────────────────────
# Slack incoming webhook URL (optional — leave blank to disable)
SLACK_WEBHOOK_URL=

# External API URL (optional — used for third-party integrations)
EXTERNAL_API_URL=

# ── Cron ──────────────────────────────────────────────────────────────────────
# Shared secret to authenticate cron-trigger requests
CRON_SECRET=your-cron-secret-here

# ── Company / Branding ────────────────────────────────────────────────────────
# Email domain used for employee email validation (e.g. acme.com)
COMPANY_EMAIL_DOMAIN=yourdomain.com

# Display name shown in notification emails
APP_NAME=Leave Management System

# Public frontend URL appended to credential emails sent to new employees
APP_URL=http://localhost:5173
